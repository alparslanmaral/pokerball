# Honoured by Cloudflare Pages and Netlify. The service worker and manifest must never be cached
# by the CDN, otherwise players would not receive new versions.
/sw.js
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/assets/*
  Cache-Control: public, max-age=31536000, immutable
